<Page
    x:Class="CineSched.App.Shell.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <CommandBar Grid.Row="0" DefaultLabelPosition="Right">
      <AppBarButton Icon="Add" Label="{Binding NewLabel}" Command="{Binding NewProjectCommand}" />
      <AppBarButton Icon="OpenFile" Label="{Binding OpenLabel}" Command="{Binding OpenProjectCommand}" />
      <AppBarButton Icon="Save" Label="{Binding SaveLabel}" Command="{Binding SaveProjectCommand}" />
      <AppBarButton Icon="SaveLocal" Label="{Binding SaveAsLabel}" Command="{Binding SaveAsProjectCommand}" />
      <AppBarSeparator />
      <AppBarButton Icon="Document" Label="{Binding ImportLabel}" Command="{Binding ImportScriptCommand}" />
      <AppBarButton Icon="Undo" Label="{Binding UndoLabel}" Command="{Binding UndoCommand}" />
      <AppBarButton Icon="Redo" Label="{Binding RedoLabel}" Command="{Binding RedoCommand}" />
    </CommandBar>

    <NavigationView x:Name="Navigation" Grid.Row="1" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                    PaneDisplayMode="LeftCompact" SelectionChanged="Navigation_SelectionChanged">
      <NavigationView.MenuItems>
        <NavigationViewItem Content="{Binding CalendarLabel}" Icon="Calendar" Tag="calendar" />
        <NavigationViewItem Content="{Binding StripboardLabel}" Icon="List" Tag="stripboard" />
        <NavigationViewItem Content="{Binding ProductionLabel}" Icon="Contact" Tag="production" />
        <NavigationViewItem Content="{Binding ReportsLabel}" Icon="Document" Tag="reports" />
        <NavigationViewItem Content="{Binding SettingsLabel}" Icon="Setting" Tag="settings" />
      </NavigationView.MenuItems>

      <Grid Padding="20">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBox Grid.Row="0" Text="{Binding ProjectTitle, Mode=TwoWay}" FontSize="24"
                 FontWeight="SemiBold" BorderThickness="0" Margin="0,0,0,12" />

        <Pivot x:Name="Workspace" Grid.Row="1">
          <PivotItem>
            <Grid ColumnSpacing="16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Padding="12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Boneyard" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <Button Content="+ Scene" Command="{Binding AddSceneCommand}" />
                  </StackPanel>
                  <TextBox Grid.Row="1" PlaceholderText="Search title, cast or summary"
                           Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,8" />
                  <ListView Grid.Row="2" ItemsSource="{Binding Boneyard}" SelectionMode="Extended"
                            CanDragItems="True" DragItemsStarting="Boneyard_DragItemsStarting"
                            SelectedItem="{Binding SelectedBoneyardScene, Mode=TwoWay}">
                    <ListView.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Padding="4">
                          <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Summary}" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </DataTemplate>
                    </ListView.ItemTemplate>
                  </ListView>
                  <Button Grid.Row="3" Content="Send to selected day" Command="{Binding SendToDayCommand}" HorizontalAlignment="Stretch" />
                </Grid>
              </Border>

              <ListView Grid.Column="1" ItemsSource="{Binding ShootDays}"
                        SelectedItem="{Binding SelectedDay, Mode=TwoWay}">
                <ListView.ItemTemplate>
                  <DataTemplate>
                    <Border Padding="12" Margin="0,0,0,8" CornerRadius="8" AllowDrop="True" Drop="CalendarDay_Drop"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                      <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="150" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Date}" FontWeight="SemiBold" />
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Scenes}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Grid.Column="2">
                          <TextBlock Text="{Binding TotalDuration}" HorizontalAlignment="Right" />
                          <TextBlock Text="eighths" Opacity="0.65" FontSize="11" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
            </Grid>
          </PivotItem>

          <PivotItem>
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
              <TextBlock Text="Selected day stripboard" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,0,0,12" />
              <ListView Grid.Row="1" ItemsSource="{Binding SelectedDayScenes}">
                <ListView.ItemTemplate>
                  <DataTemplate>
                    <Border Padding="12" Margin="0,0,0,6" CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                      <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding SceneNumber}" FontWeight="Bold" />
                        <TextBlock Grid.Column="1" Text="{Binding Title}" />
                        <TextBlock Grid.Column="2" Text="{Binding EstimatedTime}" HorizontalAlignment="Right" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
            </Grid>
          </PivotItem>

          <PivotItem>
            <StackPanel Spacing="12" MaxWidth="700" HorizontalAlignment="Left">
              <TextBlock Text="Production Setup" Style="{ThemeResource TitleTextBlockStyle}" />
              <TextBlock Text="Cast, crew and location data are stored with the project and synchronized by stable IDs." TextWrapping="Wrap" />
              <InfoBar IsOpen="True" Severity="Informational" Title="Core ready"
                       Message="ProductionService, CallSheetService, conflicts and schedule lock are available to feature editors." />
            </StackPanel>
          </PivotItem>

          <PivotItem>
            <StackPanel Spacing="16" MaxWidth="520" HorizontalAlignment="Left">
              <TextBlock Text="Export report" Style="{ThemeResource TitleTextBlockStyle}" />
              <ComboBox ItemsSource="{Binding ReportKinds}" SelectedItem="{Binding SelectedReportKind, Mode=TwoWay}" HorizontalAlignment="Stretch" />
              <Button Content="{Binding ExportLabel}" Command="{Binding ExportReportCommand}" HorizontalAlignment="Left" />
            </StackPanel>
          </PivotItem>

          <PivotItem>
            <StackPanel Spacing="16" MaxWidth="520" HorizontalAlignment="Left">
              <TextBlock Text="{Binding SettingsLabel}" Style="{ThemeResource TitleTextBlockStyle}" />
              <TextBlock Text="{Binding LanguageLabel}" />
              <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" HorizontalAlignment="Stretch" />
              <TextBlock Text="{Binding ThemeLabel}" />
              <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" HorizontalAlignment="Stretch" />
              <TextBlock Text="{Binding ColorModeLabel}" />
              <ComboBox ItemsSource="{Binding ColorModes}" SelectedItem="{Binding SelectedColorMode, Mode=TwoWay}" HorizontalAlignment="Stretch" />
              <Border Height="8" CornerRadius="4" Background="{Binding AccentBrush}" />
            </StackPanel>
          </PivotItem>
        </Pivot>
      </Grid>
    </NavigationView>

    <Border Grid.Row="2" Padding="12,6" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{Binding AccentBrush}" BorderThickness="4,0,0,0">
      <TextBlock Text="{Binding Status}" />
    </Border>
  </Grid>
</Page>
