<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-desktop</TargetFrameworks>
    <RuntimeIdentifiers>linux-x64;linux-arm64;win-x64;win-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>
    <RootNamespace>CineSched.App</RootNamespace>
    <AssemblyName>CineSched.App</AssemblyName>
    <ApplicationTitle>CineSched</ApplicationTitle>
    <ApplicationId>com.cinesched.dgd</ApplicationId>
    <ApplicationDisplayVersion>5.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationPublisher>CineSched D.G.D</ApplicationPublisher>
    <Description>Cross-platform film production scheduling with Uno Platform.</Description>
    <UnoFeatures>
      Hosting;
      Mvvm;
      SkiaRenderer;
    </UnoFeatures>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CineSched.Core\CineSched.Core.csproj" />
  </ItemGroup>
</Project>
